{
  "name": "@amoolink/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AmooLink 桌面端(Electron):设备管理 / 投屏反控 / 文件互传 / 剪贴板同步",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "check:device": "tsx scripts/check-device.ts",
    "dist": "electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@amoolink/adb": "workspace:*",
    "@amoolink/notes-editor": "workspace:*",
    "@amoolink/scrcpy-client": "workspace:*",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
