{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@amoolink/adb": ["../../packages/adb/src/index.ts"],
      "@amoolink/scrcpy-client": ["../../packages/scrcpy-client/src/index.ts"],
      "@amoolink/scrcpy-client/mp4": ["../../packages/scrcpy-client/src/mp4-recorder.ts"],
      "@amoolink/notes-editor": ["../../packages/notes-editor/src/index.ts"],
