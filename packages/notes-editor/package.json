{
  "name": "@amoolink/notes-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "笔记模块桌面内核:数据类型、Markdown frontmatter 序列化、同步引擎、Tiptap 编辑器封装(桌面 React;Android WebView 入口已拆分至独立仓库 ANotes/editor)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^3.7.0",
    "@tiptap/extension-list": "^3.7.0",
    "@tiptap/extensions": "^3.7.0",
    "@tiptap/pm": "^3.7.0",
    "@tiptap/react": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "tiptap-markdown": "^0.8.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
